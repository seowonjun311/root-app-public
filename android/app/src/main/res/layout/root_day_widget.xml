<!-- 칼로리 요약 -->
<LinearLayout
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="8dp"
  android:orientation="vertical"
  android:padding="10dp"
  android:background="@drawable/root_widget_section_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widgetCalorieTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 오늘 칼로리"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4A2A14" />

      <TextView
        android:id="@+id/widgetCalorieText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="섭취 - / 권장 - kcal\n소모 - · 남음 - kcal"
        android:textSize="11sp"
        android:textColor="#6B4A2B" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="168dp"
      android:layout_height="wrap_content"
      android:layout_marginLeft="8dp"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/widgetMealBreakfast"
          android:layout_width="0dp"
          android:layout_height="26dp"
          android:layout_weight="1"
          android:layout_marginRight="4dp"
          android:gravity="center"
          android:background="@drawable/root_widget_check_button"
          android:text="+아침"
          android:textSize="10sp"
          android:textStyle="bold"
          android:textColor="#4D7A35" />

        <TextView
          android:id="@+id/widgetMealLunch"
          android:layout_width="0dp"
          android:layout_height="26dp"
          android:layout_weight="1"
          android:gravity="center"
          android:background="@drawable/root_widget_check_button"
          android:text="+점심"
          android:textSize="10sp"
          android:textStyle="bold"
          android:textColor="#4D7A35" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/widgetMealDinner"
          android:layout_width="0dp"
          android:layout_height="26dp"
          android:layout_weight="1"
          android:layout_marginRight="4dp"
          android:gravity="center"
          android:background="@drawable/root_widget_check_button"
          android:text="+저녁"
          android:textSize="10sp"
          android:textStyle="bold"
          android:textColor="#4D7A35" />

        <TextView
          android:id="@+id/widgetMealSnack"
          android:layout_width="0dp"
          android:layout_height="26dp"
          android:layout_weight="1"
          android:gravity="center"
          android:background="@drawable/root_widget_check_button"
          android:text="+간식"
          android:textSize="10sp"
          android:textStyle="bold"
          android:textColor="#4D7A35" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>

<LinearLayout
    android:id="@+id/widget_ledger_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/root_widget_section_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_ledger_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💰 오늘의 가계부"
            android:textColor="#3D2515"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_ledger_add"
            android:layout_width="96dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="＋ 가계부"
            android:textColor="#A65322"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/root_widget_start_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_ledger_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="지출 0원 · 수입 0원"
        android:textColor="#5A3A24"
        android:textSize="12sp"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/widget_ledger_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="오늘 가계부 내역 없음"
        android:textColor="#8A6A4A"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="3dp" />
</LinearLayout>

</LinearLayout>