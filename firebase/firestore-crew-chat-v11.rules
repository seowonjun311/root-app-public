rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function isCrewOwner(crewId) {
      return signedIn()
        && crewId is string
        && exists(
          /databases/$(database)/documents/crews/$(crewId)
        )
        && get(
          /databases/$(database)/documents/crews/$(crewId)
        ).data.ownerId == request.auth.uid;
    }

    // ROOT_CREW_CHAT_V1_ACTIVE_MEMBER_BOUNDARY
    function isCrewMember(crewId) {
      return signedIn()
        && crewId is string
        && exists(
          /databases/$(database)/documents/crews/$(crewId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/crews/$(crewId)
        ).data.memberIds;
    }

    function onlyCrewMemberFieldsChanged() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'memberIds',
          'members',
          'updatedAt'
        ]);
    }

    function isFreeCrewSelfJoin() {
      return signedIn()
        && onlyCrewMemberFieldsChanged()
        && resource.data.joinType == 'free'
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds
          .hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size()
          == resource.data.memberIds.size() + 1
        && request.resource.data.members
          == resource.data.members + 1;
    }

    function isSelfLeaveCrew() {
      return signedIn()
        && onlyCrewMemberFieldsChanged()

        // 크루장은 먼저 다른 멤버에게 크루장을 위임해야 함
        && resource.data.ownerId != request.auth.uid

        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && resource.data.memberIds
          .hasAll(request.resource.data.memberIds)
        && request.resource.data.memberIds.size()
          == resource.data.memberIds.size() - 1
        && request.resource.data.members
          == resource.data.members - 1;
    }

    function isCrewOwnerUpdateWithoutTransfer() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid

        // 일반 크루 수정에서는 ownerId 변경 불가
        && request.resource.data.ownerId
          == resource.data.ownerId

        // 크루장은 항상 멤버 목록에 남아 있어야 함
        && request.auth.uid
          in request.resource.data.memberIds

        && request.resource.data.members
          == request.resource.data.memberIds.size();
    }

    function isCrewOwnershipTransfer() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'ownerId',
            'ownerNickname',
            'deleteRequestedAt',
            'updatedAt'
          ])

        && request.resource.data.ownerId
          != resource.data.ownerId

        // 새 크루장은 기존 멤버여야 함
        && request.resource.data.ownerId
          in resource.data.memberIds

        // 위임할 때 멤버 구성은 변경하지 않음
        && request.resource.data.memberIds
          == resource.data.memberIds
        && request.resource.data.members
          == resource.data.members

        && request.resource.data.ownerNickname is string

        // 이전 크루장의 해체 대기 요청은 위임 시 취소
        && request.resource.data.deleteRequestedAt == null;
    }

    // ROOT_EXPLORE_V12D5_PRIVATE_USER_SELF_ONLY_TARGET
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if isSelf(uid);
    }

    // ROOT_EXPLORE_V12D5_PUBLIC_USER_PROJECTION_TARGET
    match /rootUserPublicProfiles/{uid} {
      allow read: if signedIn();

      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'version',
          'uid',
          'displayName',
          'nickname',
          'photoURL',
          'representativeBadgeId',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'version',
          'uid',
          'displayName',
          'nickname',
          'photoURL',
          'representativeBadgeId',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.uid == uid
        && (
          request.resource.data.displayName == null
          || request.resource.data.displayName is string
        )
        && (
          request.resource.data.nickname == null
          || request.resource.data.nickname is string
        )
        && (
          request.resource.data.photoURL == null
          || request.resource.data.photoURL is string
        )
        && (
          request.resource.data.representativeBadgeId == null
          || request.resource.data.representativeBadgeId is string
        )
        && request.resource.data.updatedAt is string;

      allow delete: if isSelf(uid);
    }

    match /crews/{crewId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid
          in request.resource.data.memberIds
        && request.resource.data.members
          == request.resource.data.memberIds.size();

      allow update: if signedIn()
        && (
          isCrewOwnerUpdateWithoutTransfer()
          || isCrewOwnershipTransfer()
          || isFreeCrewSelfJoin()
          || isSelfLeaveCrew()
        );

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid

        // 다른 멤버가 남아 있으면 클라이언트에서 해체 불가
        && resource.data.memberIds.size() == 1
        && request.auth.uid in resource.data.memberIds

        // 먼저 해체 요청이 저장되어 있어야 함
        && resource.data.deleteRequestedAt != null;
    }

    // ROOT_CREW_CHAT_V11_MESSAGES_REPLIES_PHOTOS
    match /crews/{crewId}/messages/{messageId} {
      allow read: if isCrewMember(crewId);

      allow create: if isCrewMember(crewId)
        && request.resource.data.id == messageId
        && request.resource.data.crewId == crewId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorNickname is string
        && request.resource.data.authorNickname.size() > 0
        && request.resource.data.authorNickname.size() <= 40
        && request.resource.data.authorEmoji is string
        && request.resource.data.authorEmoji.size() > 0
        && request.resource.data.authorEmoji.size() <= 8
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt
          == request.resource.data.createdAt
        && (
          (
            request.resource.data.version == 1
            && request.resource.data.keys().hasOnly([
              'id',
              'version',
              'crewId',
              'authorId',
              'authorNickname',
              'authorEmoji',
              'text',
              'status',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.text.size() > 0
          )
          ||
          (
            request.resource.data.version == 2
            && request.resource.data.keys().hasOnly([
              'id',
              'version',
              'crewId',
              'authorId',
              'authorNickname',
              'authorEmoji',
              'text',
              'replyTo',
              'image',
              'status',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.keys().hasAll([
              'replyTo',
              'image'
            ])
            && (
              request.resource.data.text.size() > 0
              || request.resource.data.image != null
            )
            && (
              request.resource.data.replyTo == null
              || (
                request.resource.data.replyTo is map
                && request.resource.data.replyTo.keys().hasOnly([
                  'messageId',
                  'authorNickname',
                  'text'
                ])
                && request.resource.data.replyTo.keys().hasAll([
                  'messageId',
                  'authorNickname',
                  'text'
                ])
                && request.resource.data.replyTo.messageId is string
                && request.resource.data.replyTo.messageId.size() > 0
                && request.resource.data.replyTo.authorNickname is string
                && request.resource.data.replyTo.authorNickname.size() > 0
                && request.resource.data.replyTo.authorNickname.size() <= 40
                && request.resource.data.replyTo.text is string
                && request.resource.data.replyTo.text.size() > 0
                && request.resource.data.replyTo.text.size() <= 120
                && exists(
                  /databases/$(database)/documents/crews/$(crewId)/messages/$(request.resource.data.replyTo.messageId)
                )
              )
            )
            && (
              request.resource.data.image == null
              || (
                request.resource.data.image is map
                && request.resource.data.image.keys().hasOnly([
                  'storagePath',
                  'downloadUrl',
                  'width',
                  'height',
                  'contentType',
                  'size'
                ])
                && request.resource.data.image.keys().hasAll([
                  'storagePath',
                  'downloadUrl',
                  'width',
                  'height',
                  'contentType',
                  'size'
                ])
                && request.resource.data.image.storagePath is string
                && request.resource.data.image.storagePath.matches(
                  'crew-chat/' + crewId + '/' + request.auth.uid + '/' + messageId + '/photo\\.(jpg|png|webp)'
                )
                && request.resource.data.image.downloadUrl is string
                && request.resource.data.image.downloadUrl.size() <= 2048
                && request.resource.data.image.downloadUrl.matches(
                  'https://firebasestorage.googleapis.com/v0/b/root-c7949.firebasestorage.app/o/crew-chat%2F' + crewId + '%2F' + request.auth.uid + '%2F' + messageId + '%2Fphoto\\.(jpg|png|webp)\\?alt=media.*'
                )
                && request.resource.data.image.width is int
                && request.resource.data.image.width > 0
                && request.resource.data.image.height is int
                && request.resource.data.image.height > 0
                && request.resource.data.image.contentType in [
                  'image/jpeg',
                  'image/png',
                  'image/webp'
                ]
                && request.resource.data.image.size is int
                && request.resource.data.image.size > 0
                && request.resource.data.image.size <= 10 * 1024 * 1024
              )
            )
          )
        );

      allow update: if false;

      allow delete: if isCrewMember(crewId)
        && (
          resource.data.authorId == request.auth.uid
          || isCrewOwner(crewId)
        );
    }

    // ROOT_CREW_CHAT_V11_REACTIONS
    match /crews/{crewId}/messageReactions/{reactionId} {
      allow read: if isCrewMember(crewId);

      allow create: if isCrewMember(crewId)
        && request.resource.data.keys().hasOnly([
          'id',
          'version',
          'crewId',
          'messageId',
          'userId',
          'emoji',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'version',
          'crewId',
          'messageId',
          'userId',
          'emoji',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == reactionId
        && request.resource.data.version == 1
        && request.resource.data.crewId == crewId
        && request.resource.data.userId == request.auth.uid
        && reactionId
          == request.resource.data.messageId + '_' + request.auth.uid
        && request.resource.data.emoji in [
          '👍',
          '❤️',
          '🔥',
          '👏',
          '😂'
        ]
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt
          == request.resource.data.createdAt
        && exists(
          /databases/$(database)/documents/crews/$(crewId)/messages/$(request.resource.data.messageId)
        );

      allow update: if isCrewMember(crewId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.version == resource.data.version
        && request.resource.data.crewId == resource.data.crewId
        && request.resource.data.messageId == resource.data.messageId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.emoji in [
          '👍',
          '❤️',
          '🔥',
          '👏',
          '😂'
        ]
        && request.resource.data.updatedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'emoji',
          'updatedAt'
        ]);

      allow delete: if isCrewMember(crewId)
        && resource.data.userId == request.auth.uid;
    }

    // ROOT_CREW_CHAT_V11_REPORTS
    match /crews/{crewId}/messageReports/{reportId} {
      allow read: if isCrewMember(crewId)
        && (
          resource.data.reporterId == request.auth.uid
          || isCrewOwner(crewId)
        );

      allow create: if isCrewMember(crewId)
        && request.resource.data.keys().hasOnly([
          'id',
          'version',
          'crewId',
          'messageId',
          'messageAuthorId',
          'reporterId',
          'reason',
          'messageText',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'version',
          'crewId',
          'messageId',
          'messageAuthorId',
          'reporterId',
          'reason',
          'messageText',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == reportId
        && request.resource.data.version == 1
        && request.resource.data.crewId == crewId
        && request.resource.data.reporterId == request.auth.uid
        && reportId
          == request.resource.data.messageId + '_' + request.auth.uid
        && request.resource.data.messageAuthorId != request.auth.uid
        && request.resource.data.reason in [
          'spam',
          'harassment',
          'privacy',
          'other'
        ]
        && request.resource.data.messageText is string
        && request.resource.data.messageText.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt
          == request.resource.data.createdAt
        && exists(
          /databases/$(database)/documents/crews/$(crewId)/messages/$(request.resource.data.messageId)
        )
        && get(
          /databases/$(database)/documents/crews/$(crewId)/messages/$(request.resource.data.messageId)
        ).data.authorId == request.resource.data.messageAuthorId;

      allow update, delete: if false;
    }

    match /crewPosts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && (
          (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId
              == resource.data.userId
          )
          ||
          request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly([
              'cheers',
              'cheered',
              'comments',
              'updatedAt'
            ])
        );

      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isCrewOwner(resource.data.crewId)
          || isCrewOwner(resource.data.sharedCrewId)
        );
    }

    match /crewJoinRequests/{requestId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && (
          (
            resource.data.userId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'updatedAt'
              ])
          )
          ||
          (
            isCrewOwner(resource.data.crewId)
            && resource.data.status == 'pending'
            && (
              request.resource.data.status == 'approved'
              || request.resource.data.status == 'rejected'
            )
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'updatedAt'
              ])
          )
        );

      allow delete: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isCrewOwner(resource.data.crewId)
        );
    }

    match /crewReports/{reportId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;

      allow update: if signedIn()
        && isCrewOwner(resource.data.crewId)
        && request.resource.data
          .diff(resource.data)
          .changedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ]);

      allow delete: if signedIn()
        && isCrewOwner(resource.data.crewId);
    }

    match /crewNotifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.targetUserId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.targetUserId is string;

      allow update: if signedIn()
        && resource.data.targetUserId == request.auth.uid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['read']);

      allow delete: if signedIn()
        && (
          resource.data.targetUserId == request.auth.uid

          // 크루 해체 시 해당 크루 알림 정리
          || isCrewOwner(resource.data.postId)
        );
    }
    // ROOT_EXPLORE_V12D91_NICKNAME_REGISTRY_FOUNDATION
    // ROOT_EXPLORE_V12D92_NICKNAME_REGISTRY_ACTIVE_RULES
    match /rootNicknames/{nicknameId} {
      function nicknameWriteIsAtomicFor(uid) {
        return
          getAfter(
            /databases/$(database)/documents/users/$(uid)
          ).data.rootData.nickname == nicknameId
          &&
          getAfter(
            /databases/$(database)/documents/rootUserPublicProfiles/$(uid)
          ).data.nickname == nicknameId;
      }

      function nicknameDeleteIsAtomicFor(uid) {
        return
          getAfter(
            /databases/$(database)/documents/users/$(uid)
          ).data.rootData.nickname != nicknameId
          &&
          getAfter(
            /databases/$(database)/documents/rootUserPublicProfiles/$(uid)
          ).data.nickname != nicknameId;
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'version',
          'uid',
          'nickname',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname == nicknameId
        && nicknameWriteIsAtomicFor(request.auth.uid);

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'version',
          'uid',
          'nickname',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname == nicknameId
        && nicknameWriteIsAtomicFor(request.auth.uid);

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && nicknameDeleteIsAtomicFor(request.auth.uid);
    }    match /{document=**} {
      allow read, write: if false;
    }

    // ROOT_EXPLORE_V12D2_MERGED_MODERATION_RULES
    // ROOT_EXPLORE_V12D1_MODERATION_RULES_FRAGMENT
    //
    // IMPORTANT:
    // This is an INNER Firestore rules fragment.
    // Do not deploy this file directly.
    // Merge it inside:
    // service cloud.firestore {
    //   match /databases/{database}/documents {
    //     ...HERE...
    //   }
    // }
    //
    // V1.2E will move privileged public writes to Cloud Functions/Admin SDK.
    // Until then, moderator writes are protected by custom claims.

    // ROOT_EXPLORE_V12D4_ROOT_MODERATOR_ONLY
    function isRootPlaceModerator() {
      return request.auth != null
        && request.auth.token.rootModerator == true;
    }

    match /rootPlaceModerationInbox/{contributionId} {
      allow create: if request.auth != null
        && request.resource.data.contributorUid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.moderationStatus == 'pending'
        && request.resource.data.publicVisible == false;

      allow read, update: if isRootPlaceModerator();
      allow delete: if false;
    }

    match /rootPlaceApprovedCommunityRecords/{recordId} {
      allow read, write: if isRootPlaceModerator();
    }

    match /rootPlacePublicCommunityDistricts/{districtId} {
      allow read: if true;
      allow write: if isRootPlaceModerator();
    }

    match /rootPlaceCommunityReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read, update: if isRootPlaceModerator();
      allow delete: if false;
    }

    match /rootPlaceModerationAudit/{auditId} {
      allow read, create: if isRootPlaceModerator();
      allow update, delete: if false;
    }

    // ROOT_PLACE_V1_FIRESTORE_FOUNDATION
    // Canonical place documents are globally readable to signed-in ROOT users.
    // Client writes are disabled; canonical mutation is reserved for trusted
    // Admin/Cloud tooling after report moderation.
    match /rootPlaces/{placeId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    // ROOT_PLACE_V11_FIRESTORE_MEDIA
    // ROOT_PLACE_V12_MEDIA_FEED_MODERATION
    match /rootPlaceMedia/{mediaId} {
      allow get, list: if signedIn()
        && (
          resource.data.status == 'visible'
          || resource.data.authorUid == request.auth.uid
          || isRootPlaceModerator()
        );

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'version',
          'mediaId',
          'placeId',
          'authorUid',
          'kind',
          'source',
          'status',
          'storagePath',
          'downloadUrl',
          'thumbnailUrl',
          'capturedAt',
          'visitedAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.mediaId == mediaId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.source == 'user'
        && request.resource.data.status == 'pending';

      allow update: if (
          signedIn()
          && resource.data.authorUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.mediaId == resource.data.mediaId
          && request.resource.data.placeId == resource.data.placeId
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.source == resource.data.source
          && request.resource.data.status == 'pending'
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.downloadUrl == resource.data.downloadUrl
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || (
          isRootPlaceModerator()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['visible', 'hidden']
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'updatedAt'
            ])
        );

      allow delete: if signedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    // A user can submit and read only their own correction/new-place reports.
    // Moderation/acceptance is intentionally Admin-side.
    match /rootPlaceReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'version',
          'reportId',
          'placeId',
          'authorUid',
          'kind',
          'status',
          'value',
          'latitude',
          'longitude',
          'mediaIds',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.reportId == reportId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow get, list: if signedIn()
        && resource.data.authorUid == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.reportId == reportId
        && request.resource.data.status == 'pending';
    }

    // Visit records are private account-scoped data. Public "recent visit"
    // signals must later be projected into a separate allowlisted aggregate.
    match /rootPlaceVisits/{visitId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'version',
          'visitId',
          'placeId',
          'authorUid',
          'visitedAt',
          'latitude',
          'longitude',
          'gpsVerified',
          'mediaIds',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.visitId == visitId
        && request.resource.data.authorUid == request.auth.uid;

      allow get, list: if signedIn()
        && resource.data.authorUid == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.visitId == visitId;
    }
  }
}
